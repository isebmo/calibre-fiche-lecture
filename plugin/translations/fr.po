msgstr "Les prompts non modifiés suivent la langue de la fiche. Un prompt modifié est utilisé tel quel, quelle que soit la langue."

#: config.py:258
msgid "Restore the default prompts"
msgstr "Rétablir les prompts par défaut"

#: config.py:261
msgid "Prompts"
msgstr "Prompts"

