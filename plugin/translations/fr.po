msgstr "Titres à ignorer (regex) :"

#: config.py:186
msgid "Splitting"
msgstr "Découpage"

#: config.py:194
#, python-brace-format
msgid "Same as the calibre interface ({language})"
msgstr "Comme l'interface de calibre ({language})"

#: config.py:213
msgid "Language of the generated notes (headings, prompts and text written by the AI). You can also type another language, e.g. “日本語” or “Nederlands”: the English prompts are then used, asking for an answer in that language."
msgstr "Langue de la fiche produite (titres, prompts et texte rédigé par l'IA). Vous pouvez aussi saisir une autre langue, par ex. « 日本語 » ou « Nederlands » : les prompts anglais sont alors utilisés, avec une réponse demandée dans cette langue."

#: config.py:217
msgid "Notes language:"
msgstr "Langue de la fiche :"

#: config.py:218
msgid "Save in the book folder (calibre data files)"
msgstr "Enregistrer dans le dossier du livre (fichiers de données calibre)"

#: config.py:223
msgid "(optional) also copy to this folder"
msgstr "(facultatif) copie dans ce dossier"

#: config.py:228
msgid "Export folder:"
msgstr "Dossier d'export :"

#: config.py:229
msgid "Open the notes when generation finishes"
msgstr "Ouvrir la fiche à la fin de la génération"

#: config.py:232
msgid "Also add the notes (EPUB) as a book in the library"
msgstr "Ajouter aussi la fiche (EPUB) comme livre dans la bibliothèque"

#: config.py:233
msgid "Opens in the calibre viewer and can be sent to an e-reader. Title: “<Title> — Reading Notes” (in the notes language)."
msgstr "S'ouvre dans la liseuse de calibre et peut être envoyée sur une liseuse. Titre : « <Titre> — Fiche de lecture » (dans la langue de la fiche)."

